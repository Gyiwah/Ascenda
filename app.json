{
  "expo": {
    "name": "Ascenda",
    "slug": "ascenda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ascenda",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-router",
      "expo-web-browser"
    ],
    "android": {
      "package": "com.gyiwah.ascenda"
    },
    "extra": {
      "eas": {
        "projectId": "1feefe08-7314-4899-8c4c-9b615ed34d64"
      }
    },
    "owner": "gyiwah"
  }
}
